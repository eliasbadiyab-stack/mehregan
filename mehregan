/* ═══ DASHBOARD ═══ */
function renderDashboard(){
  const p=S.profile;const today=todayStr();
  const todaySessions=S.pomodoros.filter(x=>x.date===today);
  const studyMin=todaySessions.reduce((s,x)=>s+(x.min||25),0);
  const waterToday=S.water.filter(w=>w.date===today).length;
  const moodToday=S.moods.find(m=>m.date===today);
  const goalsSoon=S.goals.slice(0,3);
  const quotes=['«هر روز یه قدم، بعد از یه سال یه مسیر.»','«موفقیت مجموعه‌ای از تلاش‌های کوچک روزانه‌ست.»','«به خودت سخت نگیر، ولی رها هم نکن.»','«امروز بهترین روز برای شروع دوباره‌ست.»'];
  const q=quotes[new Date().getDate()%quotes.length];
  const hour=new Date().getHours();
  const greet=hour<12?'صبح بخیر':hour<17?'ظهر بخیر':hour<20?'عصر بخیر':'شب بخیر';
  const userName=(p.name||'').split(' ')[0]||'دوست من';
  return `
    ${pageHead('🌿',`${greet}، ${userName}`,today)}
    <div class="stat-grid">
      <div class="stat"><div class="stat-val">${fa(Math.round(studyMin/60*10)/10)}</div><div class="stat-lbl">ساعت مطالعه امروز</div></div>
      <div class="stat"><div class="stat-val">${fa(S.pomodoros.length)}</div><div class="stat-lbl">جلسه تمرکز</div></div>
      <div class="stat"><div class="stat-val">${fa(waterToday)}</div><div class="stat-lbl">لیوان آب 💧</div></div>
      <div class="stat"><div class="stat-val">${moodToday?moodToday.emoji:'🙂'}</div><div class="stat-lbl">حال امروز</div></div>
    </div>
    <div class="card glass" style="background:linear-gradient(135deg,var(--accent-glow),transparent)">
      <div style="font-size:1rem;font-weight:600;font-style:italic;text-align:center;line-height:2">${q}</div>
    </div>
    <div class="card glass">
      <div class="card-head"><div class="card-title"><span class="dot"></span>برنامه امروز</div></div>
      ${renderTodayItems()}
    </div>
    <div class="card glass">
      <div class="card-head"><div class="card-title"><span class="dot"></span>اهداف نزدیک</div><button class="btn btn-ghost btn-sm" onclick="nav('goals')">مشاهده همه</button></div>
      ${goalsSoon.length===0?emptyBox('🎯','هنوز هدفی ثبت نکردی','با دکمه پایین یه هدف اضافه کن'):goalsSoon.map(g=>`<div class="list-item"><div class="bar"></div><div class="body"><div class="ttl">${g.title}</div><div class="meta"><span>📅 ${g.deadline||'بدون ددلاین'}</span><span>🏷️ ${g.cat||'شخصی'}</span></div></div></div>`).join('')}
    </div>
  `;
}
function renderTodayItems(){
  const wd=todayWD();const schoolToday=S.school.filter(c=>c.day===wd);const gymToday=S.gym.filter(g=>g.day===wd);
  if(schoolToday.length===0&&gymToday.length===0)return emptyBox('🌤️','امروز کلاسی نداری','وقت خوبیه برای استراحت یا مطالعه آزاد');
  return [...schoolToday.map(c=>`<div class="list-item"><div class="bar"></div><div class="body"><div class="ttl">${c.subject}</div><div class="meta"><span>🏫 مدرسه</span><span>⏰ ${fa(c.time)}</span></div></div></div>`),...gymToday.map(g=>`<div class="list-item"><div class="bar" style="background:linear-gradient(180deg,#fb923c,#f97316)"></div><div class="body"><div class="ttl">${g.name}</div><div class="meta"><span>🏋️ ورزش</span><span>⏰ ${fa(g.time)}</span></div></div></div>`)].join('');
}

/* ═══ SCHOOL ═══ */
function renderSchool(){
  const isSummer=[4,5,6].includes(TODAY[1]);
  if(isSummer)return `${pageHead('🏫','برنامه مدرسه','تابستون تعطیله ☀️')}<div class="card glass" style="background:linear-gradient(135deg,rgba(251,191,36,.15),transparent);text-align:center"><div style="font-size:2.4rem;margin-bottom:8px">☀️</div><div style="font-weight:700;font-size:1.1rem;margin-bottom:6px">حالت تابستون فعاله</div><p style="color:var(--text-2);font-size:.9rem">برنامه مدرسه پنهان شده و مهر دوباره برمی‌گرده.</p><div style="margin-top:16px" class="badge warn">۴۵ روز تا شروع مهر</div></div>`;
  return `${pageHead('🏫','برنامه هفتگی مدرسه','زنگ‌های کلاس رو اینجا بچین')}
    <div class="card glass">
      <div class="card-head"><div class="card-title"><span class="dot"></span>زنگ‌های هفته</div><button class="btn btn-primary btn-sm" onclick="modalAddSchool()">+ افزودن زنگ</button></div>
      ${S.school.length===0?emptyBox('✨','هنوز هیچ کلاسی اضافه نکردی','آماده‌ای برنامه مدرسه‌ت رو بچینی؟'):WD.map(day=>{
