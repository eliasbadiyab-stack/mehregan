  S.gym.forEach(g=>{if(g.name.toLowerCase().includes(ql))results.push({type:'🏋️ ورزش',text:g.name,meta:g.day})});
  S.exams.forEach(e=>{if(e.subject.toLowerCase().includes(ql))results.push({type:'📝 امتحان',text:e.subject,meta:e.date||''})});
  S.goals.forEach(g=>{if(g.title.toLowerCase().includes(ql))results.push({type:'🎯 هدف',text:g.title,meta:g.deadline||''})});
  S.studyGoals.forEach(s=>{if(s.subject.toLowerCase().includes(ql))results.push({type:'📖 مطالعه',text:s.subject,meta:s.dl||''})});
  S.notes.forEach(n=>{if(n.title.toLowerCase().includes(ql)||(n.body||'').toLowerCase().includes(ql))results.push({type:'📝 یادداشت',text:n.title,meta:n.date})});
  $('#searchResults').innerHTML=results.length===0?'<p class="card-sub">چیزی پیدا نشد.</p>':results.map(r=>`<div class="list-item"><div class="bar"></div><div class="body"><div class="meta" style="color:var(--accent);font-weight:700;font-size:.72rem">${r.type}</div><div class="ttl">${r.text}</div><div class="meta"><span>${r.meta}</span></div></div></div>`).join('');
}

