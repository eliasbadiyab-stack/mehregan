    .status{color:#34d399;font-size:.82rem;margin-top:10px;opacity:0;transition:opacity .3s}
    .status.on{opacity:1}
  </style></head><body>
    <h2>📝 یادداشت سریع</h2>
    <textarea id="t" placeholder="هر چی می‌خوای اینجا بنویس...">${saved.replace(/</g,'&lt;')}</textarea>
    <div class="foot"><button class="save" onclick="save()">💾 ذخیره</button><button class="clear" onclick="clearAll()">پاک کن</button></div>
    <div class="status" id="st">ذخیره شد ✅</div>
  <script>
    function save(){localStorage.setItem('mehregan_v1_quicknotes',document.getElementById('t').value);const s=document.getElementById('st');s.classList.add('on');setTimeout(()=>s.classList.remove('on'),1500)}
    function clearAll(){if(confirm('پاک بشه؟')){document.getElementById('t').value='';save()}}
    document.getElementById('t').addEventListener('keydown',e=>{if(e.ctrlKey&&e.key==='s'){e.preventDefault();save()}})
  <\/script></body></html>`);
  notesWin.document.close();
  toast('یادداشت باز شد','📝');
}

/* ═══ THEME / LANG ═══ */
function toggleMode(){S.mode=S.mode==='dark'?'light':'dark';document.body.dataset.mode=S.mode;save();toast(S.mode==='dark'?'حالت تاریک 🌙':'حالت روشن ☀️','🎨')}
function toggleLang(){S.lang=S.lang==='fa'?'en':'fa';save();$('#langBtn').textContent=S.lang==='fa'?'EN':'FA';document.documentElement.dir=S.lang==='fa'?'rtl':'ltr';document.documentElement.lang=S.lang;toast(S.lang==='fa'?'زبان فارسی':'English mode','🌐')}

/* ═══ QUICK ADD ═══ */
function quickAdd(){
  openModal(`
    ${modalHead('➕','افزودن سریع')}
    <div class="opt-grid">
      <div class="opt" onclick="closeModal();modalAddSchool()"><div class="ic">🏫</div><div class="lbl">زنگ مدرسه</div></div>
      <div class="opt" onclick="closeModal();modalAddGym()"><div class="ic">🏋️</div><div class="lbl">ورزش</div></div>
      <div class="opt" onclick="closeModal();modalAddStudy()"><div class="ic">📚</div><div class="lbl">هدف مطالعه</div></div>
      <div class="opt" onclick="closeModal();modalAddExam()"><div class="ic">📝</div><div class="lbl">امتحان</div></div>
      <div class="opt" onclick="closeModal();modalAddGoal()"><div class="ic">🎯</div><div class="lbl">هدف</div></div>
      <div class="opt" onclick="closeModal();newNote()"><div class="ic">📄</div><div class="lbl">یادداشت</div></div>
    </div>
  `);
}

/* ═══ SHOW APP ═══ */
function showApp(){
  $('#header').classList.remove('hidden');
  $('#shell').classList.remove('hidden');
  $('#bottomNav').classList.remove('hidden');
  $('#fab').classList.remove('hidden');
  $('#buddyBtn').classList.remove('hidden');
  buildNav();
  nav('dashboard');
  setTimeout(()=>buddyTalk(),2000);
}

/* ═══ INIT ═══ */
function init(){
  load();
  document.body.dataset.theme=S.theme;
  document.body.dataset.mode=S.mode;
  document.documentElement.dir=S.lang==='fa'?'rtl':'ltr';
  buildKeypad();
  if(S.pin){$('#pinTitle').textContent='سلام، خوش برگشتی';$('#pinSub').textContent='پین ۴ رقمی خودت رو وارد کن';$('#pinEmoji').textContent='🔐'}
  else{isSetup=true;$('#pinTitle').textContent='یه پین بساز';$('#pinSub').textContent='پین ۴ رقمی برای محافظت از اطلاعاتت';$('#pinEmoji').textContent='🔒'}
  setInterval(save,30000);
  document.addEventListener('keydown',e=>{
    if(e.ctrlKey&&e.key>='1'&&e.key<='9'){e.preventDefault();const idx=+e.key-1;if(PAGES[idx])nav(PAGES[idx].id)}
    if(e.key==='Escape')closeModal();
  });
}
init();

