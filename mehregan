  const p=S.profile;const body=$('#obBody');const nextBtn=$('#obNext');
  switch(obStep){
    case 0:body.innerHTML=`<div class="step on"><div class="big-emoji">🌿</div><h2>خوش اومدی به مِهرگان</h2><p class="lead">اینجا قراره کمکت کنیم درس بخونی، هدف بذاری، به خودت برسی و پیشرفتت رو ببینی. آماده‌ای؟</p></div>`;nextBtn.textContent='بزن بریم 🚀';break;
    case 1:body.innerHTML=`<div class="step on"><h2>اسمت چیه؟</h2><p class="lead">هر اسمی که دوست داری صدات کنیم.</p><div class="field"><input type="text" id="inName" placeholder=" " value="${p.name||''}" autocomplete="off"><label>اسمت</label></div><p class="field-err" id="errName">اسمت رو بنویس تا بهتر بشناسیمت 🙂</p></div>`;nextBtn.textContent='بعدی';break;
    case 2:body.innerHTML=`<div class="step on"><h2>چند سالته؟</h2><p class="lead">سنت کمک می‌کنه برنامه‌ها و راهنمایی‌ها مناسب تو باشه.</p><div class="range-wrap"><input type="range" id="inAge" min="10" max="30" value="${p.age||15}" oninput="document.getElementById('ageLbl').textContent=toFa(this.value)"><div class="range-val" id="ageLbl">${fa(p.age||15)}</div></div><p class="card-sub center" style="margin-top:12px">سال</p></div>`;nextBtn.textContent='بعدی';break;
    case 3:{const years=[];for(let y=1370;y<=1395;y++)years.push(y);body.innerHTML=`<div class="step on"><h2>تاریخ تولدت (شمسی)</h2><p class="lead">از تقویم انتخاب کن.</p><div class="row gap-lg"><div class="field flex-1"><select id="bY">${years.map(y=>`<option value="${y}" ${p.birth&&p.birth[0]===y?'selected':''}>${fa(y)}</option>`).join('')}</select><label>سال</label></div><div class="field flex-1"><select id="bM">${MONTHS.map((m,i)=>`<option value="${i+1}" ${p.birth&&p.birth[1]===i+1?'selected':''}>${m}</option>`).join('')}</select><label>ماه</label></div><div class="field flex-1"><select id="bD">${Array.from({length:31},(_,i)=>i+1).map(d=>`<option value="${d}" ${p.birth&&p.birth[2]===d?'selected':''}>${fa(d)}</option>`).join('')}</select><label>روز</label></div></div><p class="card-sub center" style="margin-top:8px">متولد: <b id="birthPreview">${p.birth?fmtJ(p.birth[0],p.birth[1],p.birth[2]):'—'}</b></p></div>`;setTimeout(()=>{['bY','bM','bD'].forEach(id=>{const el=document.getElementById(id);if(el)el.onchange=()=>{const y=+$('#bY').value,m=+$('#bM').value,d=+$('#bD').value;$('#birthPreview').textContent=fmtJ(y,m,d)}})},50);nextBtn.textContent='بعدی';break}
    case 4:body.innerHTML=`<div class="step on"><h2>جنسیتت چیه؟</h2><p class="lead">این اطلاعات فقط روی دستگاه خودت ذخیره می‌شه و هیچ‌وقت جایی فرستاده نمی‌شه.</p><div class="opt-grid"><div class="opt ${p.gender==='male'?'sel':''}" onclick="pickGender('male')"><div class="ic">👦</div><div class="lbl">پسر</div></div><div class="opt ${p.gender==='female'?'sel':''}" onclick="pickGender('female')"><div class="ic">👧</div><div class="lbl">دختر</div></div><div class="opt ${p.gender==='trans'?'sel':''}" onclick="pickGender('trans')"><div class="ic">🌈</div><div class="lbl">ترنس</div></div></div></div>`;nextBtn.textContent='بعدی';break;
    case 5:body.innerHTML=`<div class="step on"><h2>خانواده‌ت</h2><p class="lead">این کمک می‌کنه بهتر بشناسیمت.</p><div class="field"><input type="number" id="inSib" min="0" max="15" value="${p.siblings||0}" placeholder=" "><label>تعداد خواهر و برادر</label></div><div class="field"><select id="inOrder"><option value="first" ${p.order==='first'?'selected':''}>فرزند اول</option><option value="second" ${p.order==='second'?'selected':''}>فرزند دوم</option><option value="third" ${p.order==='third'?'selected':''}>فرزند سوم</option><option value="fourth" ${p.order==='fourth'?'selected':''}>فرزند چهارم</option><option value="other" ${p.order==='other'?'selected':''}>سایر</option></select><label>فرزند چندم خانواده</label></div></div>`;nextBtn.textContent='بعدی';break;
    case 6:body.innerHTML=`<div class="step on"><h2>وضعیت تحصیلی</h2><p class="lead">کلاس و رشته‌ت رو انتخاب کن.</p><div class="field"><select id="inGrade">${['هفتم','هشتم','نهم','دهم','یازدهم','دوازدهم','فارغ‌التحصیل','دانشگاه'].map(g=>`<option value="${g}" ${p.grade===g?'selected':''}>${g}</option>`).join('')}</select><label>کلاس</label></div><div class="field"><select id="inField"><option value="">— انتخاب کن —</option>${['ریاضی و فیزیک','علوم تجربی','علوم انسانی','فنی‌وحرفه‌ای','هنر','سایر'].map(f=>`<option value="${f}" ${p.field===f?'selected':''}>${f}</option>`).join('')}</select><label>رشته</label></div><div class="field"><input type="text" id="inSchool" placeholder=" " value="${p.school||''}"><label>اسم مدرسه (اختیاری)</label></div><div class="field"><input type="text" id="inCity" placeholder=" " value="${p.city||''}"><label>شهر (اختیاری)</label></div></div>`;nextBtn.textContent='بعدی';break;
    case 7:body.innerHTML=`<div class="step on"><h2>رنگ برنامه‌ت 🎨</h2><p class="lead">می‌تونی بعداً از تنظیمات عوضش کنی.</p><div class="opt-grid"><div class="opt ${S.theme==='female'?'sel':''}" onclick="pickTheme('female')"><div class="ic">🌸</div><div class="lbl">رز</div><div class="desc">صورتی و یاسی</div></div><div class="opt ${S.theme==='male'?'sel':''}" onclick="pickTheme('male')"><div class="ic">🌊</div><div class="lbl">اقیانوس</div><div class="desc">آبی و نیلی</div></div><div class="opt ${S.theme==='neutral'?'sel':''}" onclick="pickTheme('neutral')"><div class="ic">🌈</div><div class="lbl">شفق</div><div class="desc">بنفش و فیروزه</div></div></div></div>`;nextBtn.textContent='بعدی';break;
    case 8:body.innerHTML=`<div class="step on"><div class="big-emoji">🎉</div><h2 class="center">همه‌چیز آماده‌ست!</h2><p class="lead center">خلاصه اطلاعاتت:</p><div style="background:var(--surface-2);border-radius:var(--r-md);padding:18px;border:1px solid var(--border)"><div class="row-between" style="padding:6px 0"><span style="color:var(--text-3)">اسم</span><b>${p.name||'—'}</b></div><div class="row-between" style="padding:6px 0;border-top:1px solid var(--border)"><span style="color:var(--text-3)">سن</span><b>${fa(p.age)} سال</b></div><div class="row-between" style="padding:6px 0;border-top:1px solid var(--border)"><span style="color:var(--text-3)">تاریخ تولد</span><b>${p.birth?fmtJ(p.birth[0],p.birth[1],p.birth[2]):'—'}</b></div><div class="row-between" style="padding:6px 0;border-top:1px solid var(--border)"><span style="color:var(--text-3)">جنسیت</span><b>${p.gender==='male'?'پسر':p.gender==='female'?'دختر':'ترنس'}</b></div><div class="row-between" style="padding:6px 0;border-top:1px solid var(--border)"><span style="color:var(--text-3)">کلاس</span><b>${p.grade||'—'}</b></div></div></div>`;nextBtn.textContent='شروع کنیم 🚀';break;
  }
}
function toFa(v){return fa(v)}
function pickGender(g){S.profile.gender=g;save();if(g==='female')pickTheme('female');else if(g==='male')pickTheme('male');else pickTheme('neutral');renderOb()}
function pickTheme(t){S.theme=t;document.body.dataset.theme=t;save();renderOb()}
function obNext(){
  const p=S.profile;
  if(obStep===1){const v=$('#inName')?.value.trim();if(!v){$('#errName').classList.add('show');return}p.name=v}
  if(obStep===2){p.age=+$('#inAge').value}
  if(obStep===3){p.birth=[+$('#bY').value,+$('#bM').value,+$('#bD').value]}
  if(obStep===5){p.siblings=+$('#inSib').value||0;p.order=$('#inOrder').value}
  if(obStep===6){p.grade=$('#inGrade').value;p.field=$('#inField').value;p.school=$('#inSchool').value.trim();p.city=$('#inCity').value.trim()}
  save();
  if(obStep<OB_TOTAL-1){obStep++;renderOb();return}
  S.onboarded=true;S.secQ='اسم اولین مدرسه‌ت چی بود؟';S.secA='شهید بهشتی';save();
  $('#onboard').classList.remove('show');showApp();confetti();toast(`خوش اومدی ${p.name.split(' ')[0]||'دوست من'}! 🌿`,'🎉');
}
function obPrev(){if(obStep>0){obStep--;renderOb()}}

