function fmtJ(y,m,d,wd=false){const base=`${fa(d)} ${MONTHS[m-1]} ${fa(y)}`;if(!wd)return base;const g=J.toGregorian(y,m,d);const dt=new Date(g[0],g[1]-1,g[2]);return `${WD[(dt.getDay()+1)%7]}، ${base}`}
function todayStr(){return fmtJ(TODAY[0],TODAY[1],TODAY[2])}
function todayWD(){return J.dayOfWeek(TODAY[0],TODAY[1],TODAY[2])}
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,7)}

function toast(msg,icon='✨',dur=2800){const box=$('#toasts');const el=document.createElement('div');el.className='toast';el.innerHTML=`<span style="font-size:1.1rem">${icon}</span><span>${msg}</span>`;box.appendChild(el);setTimeout(()=>{el.classList.add('out');setTimeout(()=>el.remove(),300)},dur)}
function confetti(){const colors=['#60a5fa','#f472b6','#a78bfa','#34d399','#fbbf24','#f87171'];for(let i=0;i<40;i++){const c=document.createElement('div');c.className='confetti';c.style.left=Math.random()*100+'vw';c.style.top='-20px';c.style.background=colors[Math.floor(Math.random()*colors.length)];c.style.animationDelay=Math.random()*0.5+'s';c.style.animationDuration=(1.8+Math.random()*1.2)+'s';document.body.appendChild(c);setTimeout(()=>c.remove(),3500)}}

const SK='mehregan_v1_';
const defState={
  lang:'fa',theme:'male',mode:'dark',pin:null,secQ:null,secA:null,onboarded:false,
