};
let S=JSON.parse(JSON.stringify(defState));
function save(){try{localStorage.setItem(SK+'state',JSON.stringify(S))}catch(e){}}
function load(){try{const r=localStorage.getItem(SK+'state');if(r){const p=JSON.parse(r);S={...defState,...p};if(p.profile)S.profile={...defState.profile,...p.profile}}}catch(e){}}

/* ═══ PIN ═══ */
let pinBuf='',isSetup=false,wrongTries=0;
function hash(s){let h=0;for(let i=0;i<s.length;i++){h=((h<<5)-h)+s.charCodeAt(i);h|=0}return String(h)}
function buildKeypad(){const k=$('#keypad');const keys=['1','2','3','4','5','6','7','8','9','del','0','ok'];k.innerHTML=keys.map(key=>key==='del'?`<button class="key del" data-k="del">⌫</button>`:key==='ok'?`<button class="key ok" data-k="ok">✓</button>`:`<button class="key" data-k="${key}">${fa(key)}</button>`).join('');$$('#keypad .key').forEach(b=>b.onclick=()=>pressKey(b.dataset.k))}
function pressKey(k){if(k==='del')pinBuf=pinBuf.slice(0,-1);else if(k==='ok'){if(pinBuf.length===4)submitPin();return}else{if(pinBuf.length<4)pinBuf+=k}updateDots();if(pinBuf.length===4&&k!=='ok'&&k!=='del')setTimeout(submitPin,180)}
function updateDots(){$$('#pinDots .pin-dot').forEach((d,i)=>d.classList.toggle('on',i<pinBuf.length))}
function submitPin(){
  if(isSetup){S.pin=hash(pinBuf);save();isSetup=false;pinBuf='';updateDots();toast('پین ذخیره شد','🔐');$('#pinScreen').classList.remove('show');if(S.onboarded)showApp();else startOnboard();return}
  if(hash(pinBuf)===S.pin){pinBuf='';updateDots();wrongTries=0;$('#pinScreen').classList.remove('show');if(S.onboarded)showApp();else startOnboard()}
  else{wrongTries++;pinBuf='';updateDots();const el=$('#pinScreen .sheet');el.classList.add('shake');setTimeout(()=>el.classList.remove('shake'),500);if(wrongTries>=3){$('#pinSub').textContent='۳ بار اشتباه زدی. از سوال امنیتی استفاده کن.';toast('۳ بار اشتباه!','⚠️')}else toast('پین اشتباهه. دوباره تلاش کن','🙂')}
}
function forgotPin(){const q=S.secQ||'اسم اولین مدرسه‌ت چی بود؟';const a=prompt(q);if(a===null)return;if(a.trim()===(S.secA||'')){toast('درست بود! خوش برگشتی','💜');$('#pinScreen').classList.remove('show');if(S.onboarded)showApp();else startOnboard()}else toast('پاسخ اشتباهه','❌')}
document.addEventListener('keydown',e=>{if(!$('#pinScreen').classList.contains('show'))return;if(e.key>='0'&&e.key<='9')pressKey(e.key);else if(e.key==='Backspace')pressKey('del');else if(e.key==='Enter')pressKey('ok')});

/* ═══ ONBOARDING ═══ */
const OB_TOTAL=9;let obStep=0;
function startOnboard(){obStep=0;$('#onboard').classList.add('show');renderOb()}
function renderOb(){
  $('#obSteps').innerHTML=Array.from({length:OB_TOTAL},(_,i)=>`<div class="step-dot ${i===obStep?'on':''} ${i<obStep?'done':''}"></div>`).join('');
